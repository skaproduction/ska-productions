# Password for the poster admin at /ska/admin
SKA_ADMIN_PASSWORD=change-me

# Optional: Slack/Discord webhook that receives casting inquiries
SKA_INQUIRY_WEBHOOK_URL=

# Optional: enables English -> Korean auto-translation in /ska/admin (Claude API key)
ANTHROPIC_API_KEY=

# Vercel Blob (optional locally; set on Vercel)
BLOB_READ_WRITE_TOKEN=

# Optional: email casting inquiries via Resend (resend.com)
RESEND_API_KEY=
# Optional: sender once the domain is verified in Resend, e.g. SKA Productions <booking@skaproductions.com>
SKA_MAIL_FROM=
# Optional: who receives inquiries (comma-separated). Default: terry@skaproductions.com
SKA_INQUIRY_TO=
